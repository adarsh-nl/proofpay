# ProofPay environment. Copy to .env.local and fill in values. NEVER commit .env.local.
# Server code reads these only through src/server/env.ts (zod-validated).

# ---------- PayPal (SANDBOX ONLY) ----------
PAYPAL_ENV=sandbox
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
# Developer Dashboard -> Apps & Credentials -> Sandbox -> your app
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Same value as PAYPAL_CLIENT_ID (public, used by the PayPal JS SDK in the browser)
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
# Frontend only: 1 = render pages from src/lib/fixtures/*.json instead of the API (until the routes merge)
NEXT_PUBLIC_USE_FIXTURES=0
# Stretch T16: Dashboard -> app -> Webhooks -> Webhook ID
PAYPAL_WEBHOOK_ID=
CURRENCY=USD
# 1 = serve PayPal calls from the in-memory fake (order/auth/capture/void/refund); no network, no creds
PAYPAL_MOCK=0
# 1 = the job page shows a "Simulate PayPal approval (mock)" button instead of the PayPal JS SDK
NEXT_PUBLIC_PAYPAL_MOCK=0
# Stretch T18
PAYOUTS_ENABLED=0

# ---------- AI ----------
# google | openai
AI_PROVIDER=google
# Vercel AI SDK default env names (verify in AI SDK provider docs)
GOOGLE_GENERATIVE_AI_API_KEY=
OPENAI_API_KEY=
# Verify current model IDs on the provider's models page before use
LLM_MODEL=<model-id>
VLM_MODEL=<model-id>
# 1 = no AI calls; use recorded responses from eval/fixtures (judges without a key)
VISION_MOCK=1
VLM_TIMEOUT_MS=45000

# ---------- Decision thresholds (docs/MANUAL.md §9.4) ----------
T_PASS=0.9
T_PARTIAL=0.5
T_CONF=0.75
T_LOW_CONF=0.6
PARTIAL_ROUND_TO=0.05
AUTO_CAPTURE_ON_APPROVE=1

# ---------- App ----------
APP_BASE_URL=http://localhost:3000
DATABASE_PATH=./data/proofpay.db
UPLOAD_DIR=./data/uploads
# 1 on Render (ephemeral disk): reset + seed demo jobs at boot
SEED_ON_BOOT=0
# Optional gate for /reviewer on the hosted demo
REVIEWER_PASSCODE=

# ---------- E2E only (Playwright), sandbox PERSONAL account ----------
E2E_BUYER_EMAIL=
E2E_BUYER_PASSWORD=
